# Copy this file to .env and fill in the values.
# Use the Supabase "Session pooler" string (Project > Connect). The direct db.<ref>.supabase.co host is IPv6-only.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres
SESSION_SECRET=replace-with-a-long-random-string
PORT=8080
WEB_PORT=5173
# Web origins allowed to call the API cross-origin with cookies (comma-separated). Optional.
# The Android app's origin (https://localhost) is always allowed, without cookies.
CORS_ORIGIN=

# ---- Android app (APK) ------------------------------------------------------
# Public HTTPS address of this CareTrack server, baked into the APK at build time so
# patients don't have to type it. Leave empty to ask on first launch. Not a secret.
CARETRACK_API_URL=
# Optional: enables Claude-powered insights. Without it, rule-based insights are used.
ANTHROPIC_API_KEY=

# Optional: enables Groq-powered CareTrack chatbot replies.
# The chatbot remains protected by server-side topic and medication-safety guards.
# Rotate any key that has previously been exposed in source, chat, screenshots, or files.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Login one-time codes (OTP) -------------------------------------------
# Two-step login is on by default. Set to false to sign in with password only.
OTP_ENABLED=true
# Offline mode: when the code cannot be sent (no internet / no provider set up),
# show it on the login screen instead. Set to false for a real deployment.
OTP_OFFLINE_FALLBACK=true

# Gmail: use a Google "App Password" (Google Account > Security > App passwords).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# SMS provider: semaphore | twilio | android-gateway (leave empty to disable SMS sending)
SMS_PROVIDER=
# Semaphore (semaphore.co, Philippines)
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=
# Twilio (twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# "SMS Gateway for Android" app on a phone on the same Wi-Fi (works without internet)
# e.g. http://192.168.1.50:8080
SMS_GATEWAY_URL=
SMS_GATEWAY_USER=
SMS_GATEWAY_PASSWORD=

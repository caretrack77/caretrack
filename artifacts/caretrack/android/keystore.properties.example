# Copy to keystore.properties (git-ignored) to sign release APKs.
# Create a keystore once with:
#   keytool -genkeypair -v -keystore %USERPROFILE%\.caretrack\caretrack-release.jks -alias caretrack -keyalg RSA -keysize 2048 -validity 10000
# Keep the keystore and passwords safe: Android only installs updates signed with the same key.
storeFile=C:/Users/YOU/.caretrack/caretrack-release.jks
storePassword=CHANGE_ME
keyAlias=caretrack
keyPassword=CHANGE_ME
